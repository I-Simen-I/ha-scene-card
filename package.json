{
  "name": "ha-scene-card",
  "version": "0.0.0-dev",
  "description": "A row of scene buttons for Home Assistant that show which scene is active",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "scene",
    "button",
    "toggle",
    "custom-cards"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I-Simen-I/ha-scene-card.git"
  },
  "author": "Simen Søhol",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "yarn@4.12.0",
  "license": "MIT",
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "lit": "^3.3.3",
    "prettier": "^3.10.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/*.test.mjs",
    "ha:up": "docker-compose -f dev/docker-compose.yml up -d",
    "ha:down": "docker-compose -f dev/docker-compose.yml down",
    "ha:logs": "docker-compose -f dev/docker-compose.yml logs -f"
  }
}
